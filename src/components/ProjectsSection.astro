---
interface Project {
  number: string;
  type: string;
  title: string;
  description: string;
  tags: string[];
  primary: string;
  href: string;
  image: string;
  alt: string;
}

const projects: Project[] = [
  {
    number: '01',
    type: 'AI COMPANION',
    title: 'Vivian',
    description: 'A cozy tsundere AI companion with Live2D expression, persistent memory, voice synthesis, and vision — designed to stay by your side.',
    tags: ['Live2D', 'Memory', 'Voice + Vision', 'Next.js'],
    primary: 'View on GitHub',
    href: 'https://github.com/celestial-sora/ai-waifu',
    image: 'vivian-banner-v2.jpg',
    alt: 'Vivian AI companion artwork banner',
  },
  {
    number: '02',
    type: 'AI ROLEPLAY · SEKAIRA',
    title: 'Oonchai',
    description: 'An AI roleplay platform for discovering characters, weaving interactive stories, and building conversations that remember you across worlds.',
    tags: ['AI Roleplay', 'Characters', 'Memory', 'Stories'],
    primary: 'Open project',
    href: 'https://oonchai.vercel.app/',
    image: 'oonchai-banner.svg',
    alt: 'Oonchai Sekaira AI roleplay platform banner',
  },
  {
    number: '03',
    type: 'LINUX UTILITY · VIRTUAL CAMERA',
    title: 'Kagami · 鏡',
    description: 'Wireless screen mirroring from iOS and Android to Linux, feeding directly as a V4L2 virtual camera ready for OBS Studio.',
    tags: ['Linux', 'AirPlay', 'OBS Studio', 'V4L2', 'Python/GTK4'],
    primary: 'View on GitHub',
    href: 'https://github.com/celestial-sora/kagami',
    image: 'kagami-banner.png',
    alt: 'Kagami iPad screen mirroring into OBS Studio preview',
  },
  {
    number: '04',
    type: 'AI VISUAL NOVEL · KOHARU',
    title: 'Sora Novel',
    description: "A dynamic Thai-language AI visual novel with branching paths. Guide Sora as she crafts an AI VTuber from humble beginnings to debut night.",
    tags: ['Visual Novel', 'AI Branching', 'OpenRouter', 'Web Audio'],
    primary: 'View on GitHub',
    href: 'https://github.com/celestial-sora/Sora-Novel',
    image: 'sora-novel-banner.jpg',
    alt: 'Sora Novel Project Koharu visual novel title banner',
  },
  {
    number: '05',
    type: 'OPEN MODEL · GEMMA 3 12B',
    title: 'Larp LLM',
    description: 'An internet-native LoRA adapter fine-tuned on Gemma 3 12B, accompanied by a Google Colab playground for immediate GPU-powered testing.',
    tags: ['LoRA Adapter', 'Gemma 3', 'Colab', 'Unsloth'],
    primary: 'View on GitHub',
    href: 'https://github.com/celestial-sora/Larp-LLM',
    image: 'larp-llm-banner.png',
    alt: 'Larp LLM internet-native language model banner',
  },
];
---

<section class="section-shell projects-section" id="projects" aria-labelledby="projects-heading">
  <div class="section-heading section-heading--row">
    <div>
      <span class="eyebrow">Selected work</span>
      <h2 id="projects-heading">Things I build<br /><em>when curiosity wins.</em></h2>
    </div>
    <p>A curated shelf of software, models, and story worlds shaped by genuine curiosity and craft.</p>
  </div>

  <div class="project-grid">
    {projects.map((project) => (
      <article class="project-card material-card">
        <div class="project-banner project-banner--image">
          <img
            class="project-banner__image"
            src={`/${project.image}`}
            alt={project.alt}
            loading="lazy"
            decoding="async"
          />
        </div>
        <div class="project-card__body">
          <div class="project-card__meta">
            <span class="card-kicker">{project.type}</span>
            <span class="project-card__index">{project.number}</span>
          </div>
          <h3>{project.title}</h3>
          <p>{project.description}</p>
          <div class="tag-list" aria-label="Project technologies">
            {project.tags.map((tag) => (
              <span>{tag}</span>
            ))}
          </div>
          <a
            class="button button--primary"
            href={project.href}
            target="_blank"
            rel="noopener noreferrer"
          >
            {project.primary}
            <svg class="icon-inline" viewBox="0 0 16 16" aria-hidden="true">
              <path d="M3 13 13 3M5 3h8v8" />
            </svg>
          </a>
        </div>
      </article>
    ))}
  </div>
</section>

<style>
  .project-card__meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    margin-bottom: 6px;
  }
  .project-card__index {
    font-family: var(--font-mono, monospace);
    font-size: 0.72rem;
    font-weight: 500;
    color: var(--text-muted);
    letter-spacing: 0.08em;
  }
  .project-banner {
    position: relative;
    width: 100%;
    aspect-ratio: 551 / 260;
    overflow: hidden;
    background: var(--image-surface, #2c2b28);
    border-top-left-radius: inherit;
    border-top-right-radius: inherit;
  }
  .project-banner__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
    transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .project-card:hover .project-banner__image {
    transform: scale(1.025);
  }
</style>
